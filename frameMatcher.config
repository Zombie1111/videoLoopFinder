[matching]

; Two frames must be between these many seconds apart.
min_gap_seconds = 10.0
max_gap_seconds = 15.0

; Pass 1 sampling rate across the whole video.
pass1_fps = 1.0

; IMPORTANT: use opencv_sequential for the same pHash/frame semantics
; as the original slow version, but decode the video sequentially once.
;
; ffmpeg          = fastest, but may choose slightly different frames / pixels.
; opencv_sequential = compatibility mode; recommended for matching the old result.
; chunked         = old multi-process chunk implementation.
pass1_mode = opencv_sequential

; Only used by chunked mode.
pass1_workers = 1

; Only used by ffmpeg mode.
pass1_hash_width = 256
ffmpeg_threads = 0
ffmpeg_path = <PATH TO ffmpeg.exe (C:\example\ffmpeg-n9.0-latest-win64-gpl-9.0\bin\ffmpeg.exe)>

; Pass 2
pass2_fps = 10.0
refine_window_seconds = 1.0
top_candidates = 20
pass2_workers = 6

chunk_overlap_seconds = auto

; Must remain the same as the old version for comparable results.
hash_size = 16

progress_interval_percent = 10.0

[output]
output_directory = similar_frame_results
save_top_results = 5
